# Modelo sem credenciais reais. Substitua os placeholders antes do uso manual.
# O script scripts/configure-demo.mjs configura os valores locais automaticamente.
DATABASE_URL=postgresql://SEU_USUARIO:SUA_SENHA_URL_ENCODED@127.0.0.1:5432/SEU_BANCO?schema=public
POSTGRES_USER=SEU_USUARIO
POSTGRES_PASSWORD=SUA_SENHA_LOCAL
POSTGRES_DB=SEU_BANCO
# Desativado por padrão; o código bloqueia a demonstração em produção.
DEMO_MODE=false
# Preencha com um segredo aleatório de pelo menos 32 caracteres, sem publicá-lo.
# Para gerar manualmente: openssl rand -hex 32
DEMO_SESSION_SECRET=
